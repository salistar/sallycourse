{
  "name": "sallycourse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "setup:local": "node scripts/setup.mjs",
    "up": "docker compose --profile core up -d",
    "up:full": "docker compose --profile full up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "seed": "pnpm --filter @sallycourse/worker seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
