{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@sallycourse/shared": ["../../packages/shared/src/index.ts"],
      "@sallycourse/shared/*": ["../../packages/shared/src/*"],
      "@sallycourse/db": ["../../packages/db/src/index.ts"],
      "@sallycourse/db/*": ["../../packages/db/src/*"],
      "@sallycourse/design": ["../../packages/design/src/index.ts"],
      "@sallycourse/design/*": ["../../packages/design/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
